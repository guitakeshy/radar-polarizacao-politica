# Configurações da API do YouTube
# 1. Acesse o Google Cloud Console (https://console.cloud.google.com/)
# 2. Crie um novo projeto
# 3. Acesse "APIs e Serviços" > "Biblioteca"
# 4. Pesquise por "YouTube Data API v3" e ative-a
# 5. Acesse "Credenciais" > "Criar credenciais" > "Chave de API"
# 6. Copie a chave e cole abaixo (substitua o valor de exemplo)
YOUTUBE_API_KEY=sua_chave_de_api_aqui

# Configurações do Banco de Dados
DATABASE_URL=sqlite:///data/radar_politico.db

# Configurações de Coleta
MAX_RESULTS_PER_SEARCH=50
MAX_COMMENTS_PER_VIDEO=200
